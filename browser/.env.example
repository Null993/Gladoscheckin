# 改成 DXP4800 的实际局域网 IP，不要用 127.0.0.1 / 0.0.0.0 / 公网地址
NAS_IP=192.168.1.100

# 自己生成的随机密钥，至少 32 个 ASCII 字符，无空格
# 生成：python3 -c "import secrets; print(secrets.token_hex(32))"
GLADOS_BROWSER_TOKEN=

# 远程浏览器的 VNC 密码，必须恰好 8 位英文字母/数字；不要复用上面的调用密钥
GLADOS_VNC_PASSWORD=

# Cookie 来源域名。必须与 GLADOS_COOKIE 取的域名一致，否则会话无效（卡在打开页面）。
# 例如 Cookie 来自 https://glados.one 就填 glados.one
GLADOS_ORIGIN=https://glados.one

# Debian apt 源镜像（保留现有配置，默认阿里云）
# 备选：mirrors.tuna.tsinghua.edu.cn / mirrors.ustc.edu.cn / mirrors.cloud.tencent.com
# APT_MIRROR=mirrors.aliyun.com

# PyPI 源镜像（默认清华，可调整）
# PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# 备用源，清华缺版本时会去官方源补，可留空
# PIP_EXTRA_INDEX_URL=https://pypi.org/simple

# 需要代理时可设置以下 Python 工具的代理；Chrome 使用下方 GLADOS_BROWSER_PROXY
# 地址写 NAS 局域网 IP，不能写 127.0.0.1（那是容器自己）
# HTTP_PROXY=http://192.168.1.100:7890
# HTTPS_PROXY=http://192.168.1.100:7890
# NO_PROXY=localhost,127.0.0.1

# Chrome 自身需要代理时显式配置，地址必须从容器可达。通常不需要。
# GLADOS_BROWSER_PROXY=http://192.168.0.119:7890
